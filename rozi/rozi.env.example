# === Режим ===
PAPER=true

# === Ключи Polymarket ===
PK=
FUNDER=
# Тип подписи (py-clob-client-v2). Неверный тип = 401 / ордера не проходят.
#   -1 = не передавать в клиент (дефолт SDK)
#    0 = EOA              — обычный MetaMask / hardware, ключ = адрес со средствами
#    1 = POLY_PROXY       — старые Magic / email-аккаунты
#    2 = POLY_GNOSIS_SAFE — browser wallet через proxy на сайте (MetaMask и т.п.)
#    3 = POLY_1271        — новые email / Magic / deposit wallets (частый случай после 2025–2026)
# FUNDER обязателен для 1/2/3: адрес кошелька из профиля Polymarket.com
SIGNATURE_TYPE=-1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# === Хосты ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
BINANCE_WS=wss://stream.binance.com:9443/stream
BINANCE_REST=https://api.binance.com
CHAIN_ID=137

# === Активы и ТФ ===
ASSETS=btc
TFS=15
HOURS_UTC=                    # пусто = все часы UTC

# === Ступени (уровень:референс:потолок:объём_USDC) ===
# Пример рабочей конфигурации из карточки: 0.15 и 0.10
TIERS=0.15:0.45:0.17:3,0.10:0.40:0.12:3

# === Сигнал ===
FAST_S=60.0                   # mid за последние FAST_S был >= ref
REM_MIN_FRAC=0.33             # остаток окна >= этой доли
VOL_MULT=0.0                  # фильтр объёма Binance (0 = выкл)
MAX_SPREAD=0.05

# === Фильтры входа (0 = выкл) ===
PRE_MAX_MIN=0.0
PRE_MAX_TIERS=
BN_MAX_ADVERSE_BP=0.0

# === Фильтр серий 5m (из карточки: streak ≥2) ===
STREAK_FILTER=on              # off / log / on
STREAK_5M_MIN=2
STREAK_ASSETS=btc
STREAK_ON_ERROR=pass
STREAK_LOOKBACK=100

# === Остальные фильтры BTC (в карточке выкл) ===
BN_CONFIRM=off
BTC_EXTREME=off
BTC_AMP=off
BTC_FILTERS_MODE=or

# === Исполнение (тейкер) ===
ENTRY_MODE=taker              # taker | trap
FILL_TIMEOUT_S=20.0
RETRY_PAUSE_S=1.0
RETRY_PAUSE_MAX_S=3.0
BOOK_STALE_S=2.0
ESC_STEP=0.01
ESC_EVERY_S=3.0
ESC_MAX=0.0
END_GUARD_S=30.0
MAX_TAKES=40
ONE_SIDE_PER_WINDOW=false
PRESIGN=true

# === Объём ===
DEPOSIT=100.0
STAKE_PCT=0.0                 # 0 = брать $ из TIERS; >0 = % от депозита
MIN_SHARES=5.0
MIN_NOTIONAL_USDC=1.0
MAX_PER_WINDOW_USDC=60.0
MAX_PER_HOUR_USDC=400.0
COMPOUND=true
FEE_RATE=0.07
COMPOUND_FROM=

# === Докупка (0 = выкл) ===
ADD_USDC=0.0
ADD_STEP=0.02
ADD_TOL=0.01
ADD_MAX_PX=0.50
ADD_WINDOW_S=0.0
ADD_PAUSE_S=1.0
ADD_MAX_REJECTS=3
ADD_MAX_N=0

# === Ловушка (если ENTRY_MODE=trap) ===
TRAP_OFFSET=0.02
TRAP_POLL_S=1.0
TRAP_REPLACE_S=2.0
TRAP_GTD_PAD_S=60.0
TRAP_GTD_MIN_S=200.0
TRAP_BACKOFF_MAX_S=30.0
TRAP_CANCEL_TRIES=6
TRAP_CANCEL_ALL_FALLBACK=true
TRAP_MIN_SHARES=5.0
TRAP_KILL_SLOW=true
TRAP_COND_REF=true
TRAP_FAIR_MIN=-0.05
HEARTBEAT_S=4.0

# === Исход ===
RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3.0
RESOLVE_DELAY_S=90.0
RESOLVE_TIMEOUT_S=7200.0
RESOLVE_MAX_S=21600.0

# === Прочее ===
PREROLL_S=45.0
DISCOVERY_EVERY_S=15.0
WS_STALE_S=25.0
CANCEL_ALL_ON_START=false
CLOB_MAX_CONC=4
STALL_LOG_S=5.0
DEPTH_LOG=true
JOURNAL=rozi.jsonl
PATH_LOG=rozi_path.jsonl
LOG_LEVEL=INFO
TICK_DEFAULT=0.01
