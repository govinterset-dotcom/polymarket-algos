# comeback.env — только leader_25_095_100 (5m, frac 0.25, ask >= 0.95)
PAPER=true

# keys (fill for LIVE)
PK=
FUNDER=
SIGNATURE_TYPE=-1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

ASSETS=btc
TFS=5

# только этот сигнал
DISABLE_SIGNALS=leader_20_090_095,underdog_50_040_045
SIGNAL_MAX_PX=0.99

# объём
DEPOSIT=100
STAKE_PCT=4.0
MIN_SHARES=5
MIN_USDC=1.0
COMPOUND=true
FEE_RATE=0.07
BUILDER_FEE=0.01

# исполнение
JOIN_MAX_S=15.0
END_GUARD_S=2.0
FILL_TIMEOUT_S=6.0
RETRY_S=0.4
ONE_SIDE_ONLY=true

# резолв
RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3.0
RESOLVE_DELAY_S=60.0

# без докупок и хеджей
ADD_LEVELS=
HEDGE_LEVELS=

JOURNAL=mojo.jsonl
LOG_LEVEL=INFO
PATH_LOG=
