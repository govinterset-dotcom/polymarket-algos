# path_z.env — BTC role + residual-z (recommended core)
PAPER=true

# keys (fill for LIVE)
PK=
FUNDER=
SIGNATURE_TYPE=-1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

ASSETS=btc
TFS=5,15

Z_THR=0.55
SIGNAL_MAX_PX=0.95
END_GUARD_S=3.0
JOIN_MAX_S=20.0

ONE_SIGNAL_PER_WINDOW=true
ONE_SIDE_ONLY=true

# keep: 15m_U_fav_20/25/40 + 5m_L_vs_35/40
DISABLE_SIGNALS=5m_L_vs_25,5m_L_vs_30,5m_L_vs_45,15m_L_vs_20,15m_L_vs_25,15m_U_fav_45,15m_U_fav_50

DEPOSIT=100
STAKE_PCT=3.0
MIN_SHARES=5
MIN_USDC=1.0
COMPOUND=true
FEE_RATE=0.07
BUILDER_FEE=0.01

FILL_TIMEOUT_S=5.0
RETRY_S=0.35

RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3.0

JOURNAL=path_z.jsonl
LOG_LEVEL=INFO
PATH_LOG=
