# === Режим ===
PAPER=true                    # true = бумага (ордера не уходят), false = боевой

# === Ключи Polymarket (нужны только при PAPER=false) ===
# Приватный ключ кошелька (0x...)
PK=
# Адрес funder (если используете proxy / Safe)
FUNDER=
# Тип подписи: -1 = авто, 0 = EOA, 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE
SIGNATURE_TYPE=-1

# API-ключи CLOB (можно оставить пустыми — клиент создаст/выведет сам)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# === Хосты (обычно не трогать) ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CHAIN_ID=137

# === Активы и таймфреймы ===
ASSETS=btc
TFS=5,15                      # 5m и/или 15m

# === Сигнал (ядро) ===
MIN_LOW=0.10                  # сторона в окне была <= этого mid
ENTRY_LO=0.85                 # нижняя граница коридора аска
ENTRY_HI=0.88                 # верхняя граница коридора (= потолок тейкера по сигналу)
FRAC_MIN=0.80                 # первое попадание в коридор не раньше этой доли окна
ENTRY_MIN_ASK=0.0             # отсечка: аск при входе не ниже (0 = выкл)
MAX_SPREAD=0.05
JOIN_MAX_S=15.0               # если бот подключился позже — окно пропускаем
END_GUARD_S=2.0

# === Объём ===
DEPOSIT=100.0
STAKE_PCT=4.0                 # % от депозита на сделку
MIN_SHARES=5.0
MIN_USDC=1.0
COMPOUND=true
COMPOUND_FROM=                # unix или 2026-10-29T12:00; пусто = весь журнал
FEE_RATE=0.07

# === Исполнение ===
CAP_PX=0.90
PRESIGN=true
PRESIGN_ASK=0.70
PRESIGN_FRAC=0.70
FILL_TIMEOUT_S=6.0
CONFIRM_DELAY_S=0.0           # 0 = выкл подтверждение
CONFIRM_MIN_BID=0.84
CONFIRM_MAX_ASK=0.95
RETRY_S=0.4

# === Исход ===
RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3.0
RESOLVE_DELAY_S=60.0
RESOLVE_TIMEOUT_S=28800.0
WS_STALE_S=30.0

# === Фильтры (0 = выкл) ===
MIN_DIST_BP=0.0
FAST_REC_S=0.0
DIST_SRC=minute
FILTER_LOG_ONLY=false
JUMP_LOOK_S=3.0
JUMP_MAX_MID=0.0

# === Режим сигнала ===
SIGNAL_1S=false
SHADOW=true
PATH_LOG=                     # путь к файлу посекундной книги (пусто = выкл)

# === Докупки и страховки (пусто = выкл) ===
ADD_LEVELS=
ADD_SIZE=1.0
ADD_CANCEL_BEFORE_S=1.0
HEDGE_LEVELS=
HEDGE_USDC=1.0
HEDGE_CANCEL_AT_END=true
GTD_PAD_S=30
GTD_MIN_S=200

# === Журнал ===
JOURNAL=comeback.jsonl
LOG_LEVEL=INFO
