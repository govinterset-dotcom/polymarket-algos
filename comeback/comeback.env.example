# comeback.env.example — reference paper configuration
#
# Paper validation (live Polymarket books, simulated fills only):
#   Period ~17.5h (2026-11-17 → 2026-11-18 UTC)
#   117 resolved trades · WR 96.6% · PnL +$149.32 · turnover $4,453
#   Return on turnover +3.35% · avg fill ~0.92 · max DD ~−$63 · max loss streak 1
#
# Design choices in this config:
#   • ONE_SIDE_ONLY=true — at most one side per window
#   • ENTRY corridor 0.92–0.99 · CAP_PX=0.99
#   • Dual-zone frac (early <0.65 or late ≥0.85); mid-zone treated as toxic
#   • HEDGE / ADD levels empty
#   • PAPER=true by default — safe for independent testing
#
# Filters fitted on observed data need out-of-sample checks before live use.

# =====================================================================
# comeback — BTC 5m, late entry, ask corridor 0.92–0.99, hedge OFF, one-side
# =====================================================================

# --- mode and access ---------------------------------------------------
PAPER=true                      # true — paper (no real orders); false — live
PK=
FUNDER=
SIGNATURE_TYPE=-1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- markets ------------------------------------------------------------
ASSETS=btc
TFS=5

# --- signal (core) ----------------------------------------------------
# comeback-low condition relaxed (MIN_LOW=1.0)
MIN_LOW=1.0
ENTRY_LO=0.92
ENTRY_HI=0.99
# dual-zone frac: early (<0.65) or very late (>=0.85); mid zone filtered
FRAC_MIN=0.55
FRAC_EARLY_MAX=0.65
FRAC_LATE_MIN=0.85
ENTRY_MIN_ASK=0                  # min-ask cutoff off
MAX_SPREAD=0.05
JOIN_MAX_S=15
END_GUARD_S=2
JUMP_LOOK_S=3
JUMP_MAX_MID=0                   # jump filter off
ONE_SIDE_ONLY=true               # only first qualifying side in the window

# --- size ------------------------------------------------------------
DEPOSIT=100
# venue min near 0.99 ceiling is ~$5; stake stays near $5 until deposit > $250
STAKE_PCT=2
MIN_SHARES=5
MIN_USDC=1
COMPOUND=true
COMPOUND_FROM=
FEE_RATE=0.07

# --- execution -------------------------------------------------------
# taker price ceiling = top of corridor
CAP_PX=0.99
PRESIGN=true
# pre-sign when side ask approaches the corridor
PRESIGN_ASK=0.80
# and half the window has elapsed (signals start from 55%)
PRESIGN_FRAC=0.50
FILL_TIMEOUT_S=6
RETRY_S=0.4
CONFIRM_DELAY_S=0                # delayed confirm OFF
CONFIRM_MIN_BID=0.84
CONFIRM_MAX_ASK=0.95

# --- resolution ------------------------------------------------------
RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3
RESOLVE_DELAY_S=60
RESOLVE_TIMEOUT_S=28800
WS_STALE_S=30

# --- cleanup filters (off) ---------------------------------------------
MIN_DIST_BP=0
FAST_REC_S=0
DIST_SRC=minute
FILTER_LOG_ONLY=false
BINANCE_WS=wss://stream.binance.com:9443/ws
BINANCE_REST=https://api.binance.com

# --- signal mode ----------------------------------------------------
SIGNAL_1S=false
SHADOW=true
PATH_LOG=comeback_path.jsonl

# --- limits: OFF ----------------------------------------------------
ADD_LEVELS=
ADD_SIZE=1.0
ADD_CANCEL_BEFORE_S=1.0
HEDGE_LEVELS=
HEDGE_USDC=1.0
HEDGE_CANCEL_AT_END=true
GTD_PAD_S=30
GTD_MIN_S=200

# --- journal -----------------------------------------------------------
JOURNAL=comeback.jsonl
LOG_LEVEL=INFO
