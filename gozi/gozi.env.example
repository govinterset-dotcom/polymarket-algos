# gozi.env.example — copy to gozi.env and edit
# Never commit real private keys.

PAPER=true  # true = dry-run, false = live orders
PRIVATE_KEY=  # EOA private key (never commit real key)
PK=  # alias for PRIVATE_KEY
FUNDER=  # proxy/funder address if signature_type=1 or 2
SIGNATURE_TYPE=0  # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
CLOB_HOST=https://clob.polymarket.com  # CLOB API
GAMMA_HOST=https://gamma-api.polymarket.com  # Gamma API
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

MIN_ELAPSED_SEC=270
MAX_START_PRICE=0.45
MIN_DELTA=0.30
WINDOW_MIN_SEC=2
WINDOW_MAX_SEC=6
ASK_FLOOR=0.60
ORDER_PRICE=0.75
ORDER_SIZE=5
VOLUME_MULTIPLIER=2
VOLUME_CYCLE_STEPS=4
