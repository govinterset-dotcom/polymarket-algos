# === Режим ===
PAPER=true                    # true = бумага, false = боевой

# === Ключи Polymarket (нужны только при PAPER=false) ===
PK=
FUNDER=
SIGNATURE_TYPE=-1
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# === Хосты ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CHAIN_ID=137

# === Активы ===
ASSETS=btc                    # только 5m (SIG_TF=5, TGT_TF=5 зашиты)

# === Сигнал (рывок mid Up) ===
JUMP_MIN=0.40                 # |mid(t) − mid(t−k)| >= JUMP_MIN
JUMP_LAST_S=25.0              # искать рывок в последние N секунд окна
JUMP_KS=3,5,10                # окна сравнения (секунды)
MAX_SPREAD=0.05
JUMP_MAX=0.0                  # пропускать рывок |jump| >= (0 = выкл)
SIDES=Up,Down                 # разрешённые стороны

# === Исполнение ===
LEAD_S=200.0                  # за сколько секунд до старта следить за следующим рынком
CAP_PX=0.80                   # абсолютный потолок цены тейкера
MAX_SLIP=0.03                 # потолок FAK = min(CAP_PX, ask + MAX_SLIP)
FILL_TIMEOUT_S=8.0
ENTRY_AFTER_START_S=3.0       # после старта целевого окна не пытаемся дольше
RETRY_S=0.4
END_GUARD_S=2.0

# === Объём ===
DEPOSIT=100.0
STAKE_PCT=2.0
MIN_SHARES=5.0
MIN_USDC=1.0
COMPOUND=true
COMPOUND_FROM=
FEE_RATE=0.07

# === Исход ===
RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3.0
RESOLVE_DELAY_S=60.0
RESOLVE_TIMEOUT_S=28800.0
WS_STALE_S=30.0

# === Журнал ===
PATH_LOG=                     # посекундный путь книги (пусто = выкл)
JOURNAL=premove_live.jsonl
LOG_LEVEL=INFO
