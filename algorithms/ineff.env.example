# ineff.env — edge + edge_strong only, ask in [0.30, 0.45)
# ENV_FILE=ineff.env python3 ineff.py

PAPER=true
ASSETS=btc
TFS=15
MODE=all

EDGE_MIN=0.05
EDGE_STRONG=0.10
MIN_ASK_PX=0.30
MAX_ASK_PX=0.45
ENABLE_LEAD=false
ENABLE_FALSE_DUMP=false

SKIP_TRUE_DUMP=true
ONE_PER_REASON=true
ONE_SIDE_PER_WINDOW=false
COOLDOWN_S=5

DEPOSIT=100
STAKE_PCT=5
COMPOUND=true

SLIP=0.02
CAP_PX=0.97
FEE_RATE=0.07
MIN_SHARES=5
MIN_USDC=1

JOURNAL=ineff.jsonl
LOG_LEVEL=INFO
