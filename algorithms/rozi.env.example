# rozi.py — H1 forward test: tier 0.10, mid drop >= ~0.15 in 60s, 15m
# ENV_FILE=rozi.env python3 rozi.py

PAPER=true
ASSETS=btc,eth,sol,xrp
TFS=15

TIERS=0.10:0.25:0.12:3
FAST_S=60
REM_MIN_FRAC=0.33
MAX_SPREAD=0.05
ONE_SIDE_PER_WINDOW=false

VOL_MULT=0
STREAK_FILTER=off
BTC_EXTREME=off
BN_CONFIRM=off
PRE_MAX_MIN=0
BN_MAX_ADVERSE_BP=0
ADD_USDC=0

DEPOSIT=100
STAKE_PCT=0
COMPOUND=false
MAX_PER_WINDOW_USDC=60
MAX_PER_HOUR_USDC=400
FEE_RATE=0.07

JOURNAL=rozi_h1.jsonl
PATH_LOG=rozi_h1_path.jsonl
DEPTH_LOG=true
