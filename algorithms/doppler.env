# lotto01.env — лимитка BUY 0.01 на поздний переворот лидера (5m + 15m, 4 актива)
# Ключи — из своего env (в файле пусто)
PK=
FUNDER=
SIGNATURE_TYPE=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# true — бумага: тейкер «наливается» по книге через PAPER_LAT_S (всё по <= SWEEP_PX, до SWEEP_USDC)
PAPER=true
ASSETS=btc,eth,sol,xrp
TFS=5,15

# ── сигнал «почти уверенный лидер рухнул» (ВЫБРАНО 04.11):
# сторона в этом окне уже была >= LEAD_MIN (0.98), после FRAC_MIN окна её аск впервые <= TRIGGER_ASK (0.01),
# до конца окна >= MIN_REM_S_x. Первое касание 0.01, все активы, 5m+15m, по высоте лидера до обвала (безубыток 1%):
#   лидер 0.90–0.95: окт 1.2% (5/427), ноя 0% (0/131) | 0.95–0.98: окт 0/186, ноя 0/70
#   лидер >= 0.98:   окт 3.9% (4/102), ноя 5.3% (2/38) — повторилось на двух независимых периодах
#   + >= 10 с до конца: окт 3/78, ноя 2/31; >= 35 с оставлял почти ничего (окт 23, ноя 2)
#   ~20 касаний в сутки на 4 активах; с тонким дном (<= 15 долей) — 3/47, но меньше сигналов
LEAD_MIN=0.98
FRAC_MIN=0.70
TRIGGER_ASK=0.0105
MIN_REM_S_5=10
MAX_REM_S_5=0
MIN_REM_S_15=10
MAX_REM_S_15=0
# фильтр «тонкого дна» выкл (0); включить — DEPTH_MAX=15
DEPTH_PX=0.01
DEPTH_MAX=0
# Chainlink выкл (пусто): на старых данных ничего не отделял; значение пишется в журнал (cl_sig)
CL_SIG_MIN=
CL_FAIL_OPEN=false
# старые фильтры выключены: скорость обвала (DROP_S=0) и прошлая минута Binance (пусто — без границы)
DROP_FROM=0.50
DROP_S=0
PREV_Z_MIN=
PREV_Z_MAX=
SIGMA_MIN=60
MAX_SPREAD=0.05
BN_FAIL_OPEN=false

# ── вход: тейкер FAK — забрать всё, что продают по <= SWEEP_PX, не больше SWEEP_USDC $ за сигнал.
# В книге ничего не висит: налив только того, что стоит в момент сигнала (лимитка 0.01 доливалась в основном
# в проигрышных окнах — 9 из 9 реальных наливов на 5m проиграли). В журнале event=sweep: доли, $, avg_px, fee_est
ENTRY_MODE=sweep
SWEEP_PX=0.03
SWEEP_USDC=10
FEE_RATE=0.07
# старый режим (ENTRY_MODE=limit): лимитка ORDER_PX × SHARES, GTD
ORDER_PX=0.01
SHARES=100
GTD_PAD_S=30
GTD_MIN_S=200
# 0 = без лимита
MAX_ORDERS_PER_HOUR=0
PAPER_LAT_S=0.3
# мониторинг после касания (только запись): через эти секунды после КАЖДОГО кандидата (и пропущенного)
# пишется event=cand_after — объём на дне (dep01, <= DEPTH_PX) и до SWEEP_PX (dep03), аск/бид/mid стороны; пусто = выкл
AFTER_S=0.5,1,2,5

# запись Chainlink TWAP (RTDS) в кандидатов — для следующего фильтра
TWAP_LOG=true
RTDS_URL=wss://ws-live-data.polymarket.com
TWAP_TOPIC=crypto_prices_twap_sixty

# ── исследовательская запись (probe) — без входа, отдельный журнал; торговлю не меняет
# на ПЕРВОМ за окно касании аска стороны каждого уровня (после PROBE_FRAC_MIN окна) пишется снимок:
# книга стороны до PROBE_DEPTH, объёмы бидов/асков (< 0.01, <= 0.01/0.02/0.03) сейчас, медиана за 60 с и 1/5/10/30 с назад,
# лидер / доля окна / скорость обвала / mid N с назад / число обновлений книги, Binance по активу
# (до TWAP-страйка, модель TWAP, ход за 15/60 с, σ), Chainlink. После резолва — probe_result с победителем.
# Окна PROBE_TFS × PROBE_ASSETS слушаются даже если не торгуются (ASSETS/TFS выше — только торговля)
# Объём журнала ~15–25 МБ в сутки на 4 актива × 2 ТФ
PROBE=true
PROBE_ASSETS=btc,eth,sol,xrp
PROBE_TFS=5,15
PROBE_LEVELS=0.03,0.02,0.01,0.005,0.001
PROBE_DEPTH=0.03
PROBE_FRAC_MIN=0.5
PROBE_JOURNAL=lotto01_probe.jsonl
PROBE_BN=true

RESOLVE_TIMEOUT_S=3600
JOURNAL=lotto01.jsonl
LOG_LEVEL=INFO
