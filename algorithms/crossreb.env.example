# crossreb.env — stable path config
# CROSS 0.70 / ask<=0.80, one trade per window (ONE_SIDE_PER_WINDOW)
# Run: ENV_FILE=crossreb.env python3 crossreb.py

PAPER=true
ASSETS=btc
TFS=15

ENABLE_CROSS=true
CROSS_BELOW=0.65
CROSS_THR=0.70
CROSS_MAX_ASK=0.80
CROSS_FRAC_LO=0.15
CROSS_FRAC_HI=0.92

ENABLE_REBOUND=true
REB_MIN_LOW=0.25
REB_LO=0.70
REB_HI=0.85
REB_FRAC_MIN=0.50

ONE_PER_REASON=true
ONE_SIDE_PER_WINDOW=true
COOLDOWN_S=3
MAX_SPREAD=0.06
REM_MIN_FRAC=0.08
END_GUARD_S=15

DEPOSIT=100
STAKE_PCT=3
COMPOUND=true

SLIP=0.02
CAP_PX=0.92
FEE_RATE=0.07
BUILDER_FEE=0.01
MIN_SHARES=5
MIN_USDC=1

RESOLVE_BY_BOOK=true
BOOK_WIN_PX=0.99
BOOK_HOLD_S=3

JOURNAL=crossreb.jsonl
LOG_LEVEL=INFO
