# ineff.env — lead (ask<0.60) + false_dump; edge/strong выкл
# ENV_FILE=ineff.env python3 ineff.py

PAPER=true
ASSETS=btc
TFS=15
MODE=all

EDGE_MIN=0.05
EDGE_STRONG=0.10

ENABLE_LEAD=true
ENABLE_FALSE_DUMP=true
ENABLE_EDGE=false
ENABLE_EDGE_STRONG=false

LEAD_MIN_ASK=0.0
LEAD_MAX_ASK=0.60

# если снова включите edge:
MIN_ASK_PX=0.30
MAX_ASK_PX=0.45

SKIP_TRUE_DUMP=true
ONE_PER_REASON=true
ONE_SIDE_PER_WINDOW=false
COOLDOWN_S=5

DEPOSIT=100
STAKE_PCT=5
COMPOUND=true

# изолированно по reason (опционально)
# DEPOSIT_LEAD=100
# STAKE_PCT_LEAD=5
# DEPOSIT_FALSE_DUMP=100
# STAKE_PCT_FALSE_DUMP=5

SLIP=0.02
CAP_PX=0.97
FEE_RATE=0.07
MIN_SHARES=5
MIN_USDC=1

JOURNAL=ineff.jsonl
LOG_LEVEL=INFO
